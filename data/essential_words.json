    {
      "id": "write-upgrade",
      "module": "writing",
      "title": "写作高频替换 · 动词升级",
      "scene": "Task 2 别再用 very good / a lot of。把口water词换成书面语，Lexical Resource 立刻上一个档。",
      "words": [
        { "en": "improve → enhance / boost", "cn": "提升", "tip": "enhance 更书面；boost 有「推动」感" },
        { "en": "reduce → mitigate / curb", "cn": "减少/遏制", "tip": "mitigate risks / curb emissions" },
        { "en": "cause → give rise to / lead to", "cn": "导致", "tip": "give rise to 更正式" },
        { "en": "solve → address / tackle", "cn": "解决", "tip": "address the issue 搭配最高频" },
        { "en": "use → utilise / adopt", "cn": "使用/采用", "tip": "别滥用 utilise，adopt 强调「采纳方法」" },
        { "en": "show → demonstrate / indicate", "cn": "表明", "tip": "Task 1 描述数据用 indicate / illustrate" },
        { "en": "think → argue / maintain / contend", "cn": "认为", "tip": "argue 最常用，观点感强" },
        { "en": "important → crucial / vital / paramount", "cn": "重要的", "tip": "paramount 程度最高，慎用" },
        { "en": "many → a growing number of / numerous", "cn": "许多", "tip": "a growing number of 自带「趋势」" },
        { "en": "more and more → increasingly", "cn": "越来越", "tip": "increasingly popular 直接替换" }
      ]
    },
