    {
      "id": "speak-link",
      "module": "speaking",
      "title": "口语衔接 · 自然过渡",
      "scene": "口语考的是「像说话」。这 10 个过渡语能让答案流畅不背稿，比大词更拉分。",
      "words": [
        { "en": "Well, ...", "cn": "（起缓冲）", "tip": "争取思考时间的自然开头" },
        { "en": "Actually, ...", "cn": "实际上", "tip": "纠正或强调时用" },
        { "en": "The thing is, ...", "cn": "问题是/重点是", "tip": "引出核心观点" },
        { "en": "To be honest, ...", "cn": "说实话", "tip": "引出个人真实感受" },
        { "en": "It depends, really.", "cn": "看情况", "tip": "Part 3 万能起手，但后面必须展开" },
        { "en": "What I mean is ...", "cn": "我的意思是", "tip": "自我澄清，考官很吃这套" },
        { "en": "Off the top of my head, ...", "cn": "随口一说", "tip": "表示不假思索，很地道" },
        { "en": "In the long run, ...", "cn": "长远来看", "tip": "Part 3 讨论 and 展望" },
        { "en": "That reminds me of ...", "cn": "这让我想起", "tip": "Part 2 讲故事衔接" },
        { "en": "So, yeah, that's basically it.", "cn": "差不多就是这样", "tip": "自然收尾，比突然沉默好" }
      ]
    },
    {
      "id": "read-syn",
      "module": "reading",
      "title": "阅读高频同义替换",
      "scene": "雅思阅读的本质是「同义替换连线题」。题干和原文永远不用同一个词——这 10 组出现率最高。",
      "words": [
        { "en": "significant ↔ considerable", "cn": "显著的", "tip": "a significant number = a considerable number" },
        { "en": "decline ↔ deterioration", "cn": "下降/恶化", "tip": "名词形式替换最常见" },
        { "en": "impact ↔ effect / implication", "cn": "影响", "tip": "implication 偏「深远影响」" },
        { "en": "predict ↔ forecast / anticipate", "cn": "预测", "tip": "题干 predict，原文常写 anticipate" },
        { "en": "limit ↔ restrict / curb / constrain", "cn": "限制", "tip": "四个都要认识" },
        { "en": "ancient ↔ dating back / long-standing", "cn": "古老的", "tip": "原文用短语，题干用单词" },
        { "en": "fund ↔ finance / subsidise", "cn": "资助", "tip": "funding = financial support" },
        { "en": "observe ↔ note / record", "cn": "观察到", "tip": "研究报告语境高频" },
        { "en": "expand ↔ scale up / widen", "cn": "扩大", "tip": "scale up 商业语境多" },
        { "en": "accurate ↔ precise / exact", "cn": "准确的", "tip": "accuracy 名词必背" }
      ]
